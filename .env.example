# ScopeGhost Environment Configuration Example
# Copy to .env.local to customize for local development.

# Local Ollama Base URL (must be a local loopback address: 127.0.0.1 or localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configured Ollama model tag (default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# SQLite Database File Path (default: ./data/scopeghost.db)
# DATABASE_PATH=./data/scopeghost.db
